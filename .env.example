# Local development only. Replace placeholders with the existing project values.
APP_ENV=development
# Format: postgresql+psycopg://<user>[:<password>]@<host>:<port>/<database>
# A local Homebrew/Postgres.app server with trust auth needs no password.
DATABASE_URL=postgresql+psycopg://<user>@localhost:5432/facilityops

# Use the full project-scoped endpoint from the existing Foundry project.
FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=gpt-5.2

# Configure these with existing Azure AI resources. The workflow fails closed if absent.
# One AIServices resource (https://<name>.cognitiveservices.azure.com/) covers all four.
AZURE_LANGUAGE_ENDPOINT=
CONTENT_SAFETY_ENDPOINT=
VISION_ENDPOINT=
SPEECH_ENDPOINT=
DOCUMENT_INTELLIGENCE_ENDPOINT=
# Staff translation of non-English requests (same AI Services resource works); empty = no translation
TRANSLATOR_ENDPOINT=
STAFF_LANGUAGE=en

# JSON arrays are parsed by Pydantic Settings.
FRONTEND_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
MAX_REQUEST_BODY_BYTES=12582912

# Development auth is for local testing only. Production requires Entra validation.
# With AUTH_ENABLED=false, pick a local identity per request with the X-Dev-User header.
AUTH_ENABLED=false
# Staff: workforce Entra ID (see docs/identity-setup.md). Staff get no role until an admin assigns one.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_WORKFORCE_DEFAULT_ROLE=
# Residents: Entra External ID (scripts/setup_entra_external.sh prints these values).
ENTRA_EXTERNAL_TENANT_ID=
ENTRA_EXTERNAL_TENANT_SUBDOMAIN=
ENTRA_EXTERNAL_API_AUDIENCE=
# Role given on first sign-in; leave empty so new users have no access until an admin assigns one.
DEFAULT_USER_ROLE=tenant

# Classification routing: answers with confidence in [LOW, HIGH) are re-classified
# CLASSIFICATION_CONFIRMATIONS times and automated only if all agree. 0 disables it.
CLASSIFICATION_BAND_LOW=0.70
CLASSIFICATION_BAND_HIGH=0.80
CLASSIFICATION_CONFIRMATIONS=2

# Replace these before deploying; never reuse development values in production.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_HMAC_SECRET=development-only-change-me
PII_MAPPING_ENCRYPTION_KEY=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Phase 2: Foundry IQ knowledge base on Azure AI Search (Entra auth, no keys)
AZURE_SEARCH_ENDPOINT=

# Demo accounts (alice, fm, tech, local-developer) created by the migrations for local learning.
# Never created when APP_ENV=production. Set to false to skip them; remove later with:
#   scripts/db.sh remove-demo-accounts
SEED_DEMO_ACCOUNTS=true

# Transparency: store what each model was sent and answered (redacted text only), for the decision trail
CAPTURE_MODEL_CONTENT=true
MODEL_CONTENT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=730
# Logs: json in production (one object per line with request_id and trace_id), text locally
LOG_FORMAT=text
LOG_LEVEL=INFO
