# Optional Azure settings for `docker compose up`. Copy to .env.docker (gitignored) and fill in.
# Without this file the app still runs; AI steps fail closed to human review.

# Your own Azure resources. One AIServices resource (https://<name>.cognitiveservices.azure.com/)
# covers Language, Content Safety, Vision and Speech.
FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=gpt-5.2
AZURE_LANGUAGE_ENDPOINT=
CONTENT_SAFETY_ENDPOINT=
VISION_ENDPOINT=
SPEECH_ENDPOINT=
DOCUMENT_INTELLIGENCE_ENDPOINT=
# Staff translation of non-English requests (same AI Services resource works); empty = no translation
TRANSLATOR_ENDPOINT=
STAFF_LANGUAGE=en

# Encrypts the PII mapping. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_MAPPING_ENCRYPTION_KEY=

# A container cannot use your `az login`, so it signs in to Azure as a service principal
# (an app registration) with roles on the resources above: "Foundry User" on the Foundry
# resource covers all four AI services. This is a secret: keep it only in .env.docker.
# In Azure (Container Apps or AKS), use a managed or workload identity instead: no secret at all.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional: OpenTelemetry export to Application Insights.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Transparency: store what each model was sent and answered (redacted text only), for the decision trail
CAPTURE_MODEL_CONTENT=true
MODEL_CONTENT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=730
# Logs: json in production (one object per line with request_id and trace_id), text locally
LOG_FORMAT=text
LOG_LEVEL=INFO
