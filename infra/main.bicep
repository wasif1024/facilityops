// FacilityOps AI on Azure (FR-32): `azd up` provisions this, then deploys the three apps.
//
// Creates, in one new resource group: a managed identity, Log Analytics + Application Insights,
// a container registry, Key Vault, PostgreSQL (Entra-only), a Service Bus topic and the
// Container Apps (API, worker, web). REUSES the existing AI Services resource and AI Search
// service: it only grants the managed identity read/use roles on them, never changes them.
// See docs/deployment.md for the steps, the costs and what each resource is for.
targetScope = 'subscription'

@minLength(3)
@maxLength(20)
@description('azd environment name, for example "facilityops-dev". Used in every resource name.')
param environmentName string

@description('Region for the new resources.')
param location string

@description('Existing AI Services (Foundry) resource that serves the models and AI services.')
param aiServicesName string

@description('Resource group of the existing AI Services resource and AI Search service.')
param aiResourceGroupName string

@description('Existing AI Search service behind the Foundry IQ knowledge base; empty to run without knowledge.')
param searchServiceName string = ''

@description('Foundry project endpoint; empty uses https://<aiServicesName>.services.ai.azure.com.')
param foundryEndpoint string = ''

param classifierModel string = 'gpt-5.2'
param incidentManagerModel string = 'gpt-5.2'
param incidentSpecialistModel string = 'gpt-5.4-mini'

@description('Sign-in settings from scripts/setup_entra_external.sh and docs/identity-setup.md.')
param entraWorkforceTenantId string
param entraWorkforceApiAudience string
param entraExternalTenantId string = ''
param entraExternalTenantSubdomain string = ''
param entraExternalApiAudience string = ''

@secure()
@description('Fernet key for the protected PII mapping; generated by infra/hooks/preprovision.sh.')
param piiMappingEncryptionKey string

@secure()
@description('HMAC secret for per-user rate-limit buckets; generated by infra/hooks/preprovision.sh.')
param rateLimitHmacSecret string

var name = toLower(environmentName)
var tags = { 'azd-env-name': environmentName, project: 'facilityops-ai' }

resource group 'Microsoft.Resources/resourceGroups@2025-04-01' = {
  name: 'rg-${name}'
  location: location
  tags: tags
}

module identity 'modules/identity.bicep' = {
  name: 'identity'
  scope: group
  params: { name: name, location: location, tags: tags }
}

module monitoring 'modules/monitoring.bicep' = {
  name: 'monitoring'
  scope: group
  params: { name: name, location: location, tags: tags, identityPrincipalId: identity.outputs.principalId }
}

module registry 'modules/registry.bicep' = {
  name: 'registry'
  scope: group
  params: { name: name, location: location, tags: tags, identityPrincipalId: identity.outputs.principalId }
}

module vault 'modules/key-vault.bicep' = {
  name: 'key-vault'
  scope: group
  params: {
    name: name
    location: location
    tags: tags
    identityPrincipalId: identity.outputs.principalId
    piiMappingEncryptionKey: piiMappingEncryptionKey
    rateLimitHmacSecret: rateLimitHmacSecret
  }
}

module postgres 'modules/postgres.bicep' = {
  name: 'postgres'
  scope: group
  params: {
    name: name
    location: location
    tags: tags
    identityName: identity.outputs.name
    identityPrincipalId: identity.outputs.principalId
  }
}

module serviceBus 'modules/service-bus.bicep' = {
  name: 'service-bus'
  scope: group
  params: { name: name, location: location, tags: tags, identityPrincipalId: identity.outputs.principalId }
}

module aiAccess 'modules/ai-access.bicep' = {
  name: 'ai-access'
  scope: resourceGroup(aiResourceGroupName)
  params: {
    aiServicesName: aiServicesName
    searchServiceName: searchServiceName
    identityPrincipalId: identity.outputs.principalId
  }
}

module apps 'modules/container-apps.bicep' = {
  name: 'container-apps'
  scope: group
  params: {
    name: name
    location: location
    tags: tags
    identityId: identity.outputs.id
    identityClientId: identity.outputs.clientId
    identityName: identity.outputs.name
    logsWorkspaceName: monitoring.outputs.logsWorkspaceName
    registryServer: registry.outputs.loginServer
    appInsightsConnectionString: monitoring.outputs.appInsightsConnectionString
    piiKeyUri: vault.outputs.piiKeyUri
    hmacSecretUri: vault.outputs.hmacSecretUri
    postgresHost: postgres.outputs.host
    databaseName: postgres.outputs.databaseName
    serviceBusHost: serviceBus.outputs.namespaceHost
    serviceBusTopic: serviceBus.outputs.topicName
    aiServicesEndpoint: aiAccess.outputs.aiServicesEndpoint
    foundryEndpoint: empty(foundryEndpoint) ? 'https://${aiServicesName}.services.ai.azure.com' : foundryEndpoint
    searchEndpoint: aiAccess.outputs.searchEndpoint
    classifierModel: classifierModel
    incidentManagerModel: incidentManagerModel
    incidentSpecialistModel: incidentSpecialistModel
    entra: {
      workforceTenantId: entraWorkforceTenantId
      workforceApiAudience: entraWorkforceApiAudience
      externalTenantId: entraExternalTenantId
      externalTenantSubdomain: entraExternalTenantSubdomain
      externalApiAudience: entraExternalApiAudience
    }
  }
  // The apps read Key Vault secrets and pull images at creation, so their role assignments must exist first:
  // the outputs used above (secret URIs, registry server, endpoints) make Bicep wait for those modules.
}

// azd stores these in the environment; the web image is built with API_BASE_URL (azure.yaml).
output AZURE_RESOURCE_GROUP string = group.name
output AZURE_CONTAINER_REGISTRY_ENDPOINT string = registry.outputs.loginServer
output AZURE_CONTAINER_APPS_ENVIRONMENT_NAME string = apps.outputs.environmentName
output API_BASE_URL string = apps.outputs.apiUrl
output WEB_URL string = apps.outputs.webUrl
output API_APP_NAME string = apps.outputs.apiName
output WORKER_APP_NAME string = apps.outputs.workerName
output KEY_VAULT_NAME string = vault.outputs.name
output POSTGRES_HOST string = postgres.outputs.host
output SERVICE_BUS_NAMESPACE string = serviceBus.outputs.namespaceHost
