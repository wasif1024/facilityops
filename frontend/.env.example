# Copy to .env.local (gitignored). Vite exposes only VITE_* variables to the browser:
# never put secrets here, everything below ends up in the JavaScript bundle.

# Backend origin (native or Docker); its FRONTEND_ORIGINS already allows http://localhost:5173.
VITE_API_BASE_URL=http://localhost:8000

# dev:   no sign-in; pick an identity in the header (backend AUTH_ENABLED=false)
# entra: Microsoft Entra ID sign-in through MSAL (backend AUTH_ENABLED=true)
VITE_AUTH_MODE=dev

# Entra mode, staff door: SPA app registration in the workforce tenant, and the API scope.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=api://<staff-api-app-id>/access_as_user

# Entra mode, residents door: SPA app registration in the Entra External ID tenant.
# The subdomain is the part before .ciamlogin.com (and before .onmicrosoft.com).
VITE_EXTERNAL_CLIENT_ID=
VITE_EXTERNAL_TENANT_SUBDOMAIN=
VITE_EXTERNAL_TENANT_ID=
VITE_EXTERNAL_API_SCOPE=api://<resident-api-app-id>/access_as_user
