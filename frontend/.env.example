# Copy to .env.local (gitignored). Vite exposes only VITE_* variables to the browser:
# never put secrets here, everything below ends up in the JavaScript bundle.

# Backend origin (native or Docker); its FRONTEND_ORIGINS already allows http://localhost:5173.
VITE_API_BASE_URL=http://localhost:8000

# dev:   no sign-in; pick an identity in the header (backend AUTH_ENABLED=false)
# entra: Microsoft Entra ID sign-in through MSAL (backend AUTH_ENABLED=true)
VITE_AUTH_MODE=dev

# Entra mode only: the SPA app registration, your tenant, and the API scope it requests.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=api://<api-app-id>/access_as_user
